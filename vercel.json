{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/gallery",
      "destination": "/the-looks.html"
    },
    {
      "source": "/the-looks",
      "destination": "/the-looks.html"
    },
    {
      "source": "/gallery-1",
      "destination": "/the-looks.html?look=gallery-1"
    },
    {
      "source": "/gallery-2",
      "destination": "/the-looks.html?look=gallery-2"
    },
    {
      "source": "/gallery-3",
      "destination": "/the-looks.html?look=gallery-3"
    },
    {
      "source": "/gallery-4",
      "destination": "/the-looks.html?look=gallery-4"
    },
    {
      "source": "/experience",
      "destination": "/experience.html"
    },
    {
      "source": "/meet-cintya",
      "destination": "/meet-cintya.html"
    },
    {
      "source": "/book-me",
      "destination": "/book-me.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: http: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: http: blob:; style-src 'self' 'unsafe-inline' https: http:; img-src 'self' https: http: data: blob:; font-src 'self' https: http: data:; frame-src 'self' https: http:; connect-src 'self' https: http:;"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
